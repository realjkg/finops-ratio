# Copy to .env.engagement (gitignored by .env*) and fill in. Names only here: never commit values.
# Passwords are placed into connection URLs: use URL-safe characters (for example `openssl rand -hex 24`).
RATIO_ENGAGEMENT_PG_SUPERUSER_PASSWORD=
RATIO_ENGAGEMENT_MIGRATOR_PASSWORD=
RATIO_ENGAGEMENT_WORKER_PASSWORD=
RATIO_ENGAGEMENT_READER_PASSWORD=
RATIO_ENGAGEMENT_S3_ACCESS_KEY_ID=
RATIO_ENGAGEMENT_S3_SECRET_ACCESS_KEY=
# R2 sign-in. The https origin users open (your TLS proxy in front of 127.0.0.1:RATIO_ENGAGEMENT_APP_PORT).
RATIO_ENGAGEMENT_ORIGIN=
# Proxies that append to X-Forwarded-For between the user and the app (1 behind one TLS proxy; 0 = reached directly).
RATIO_TRUSTED_PROXY_HOPS=1
# One OIDC client secret per identity connection, named by its clientSecretRef (RATIO_OIDC_CLIENT_SECRET_*).
RATIO_OIDC_CLIENT_SECRET_PRIMARY=
# Host paths, mounted read-only into the containers (users.json is writable only for the `users` job).
RATIO_ENGAGEMENT_CONFIG_FILE=
RATIO_ENGAGEMENT_USERS_FILE=
# Optional.
RATIO_ENGAGEMENT_APP_PORT=3100
RATIO_ENGAGEMENT_TAG=local
