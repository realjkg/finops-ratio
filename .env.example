# Ratio environment configuration. EVERY variable below is optional: with none
# set, the app runs fully offline on the data-grounded mock (MockAIClient).

# --- Wave3b AIClient seam (server-side only — keys NEVER reach the browser) ---
# Provider router. One of: claude | openai | openllm | mock. Default: mock.
AI_PROVIDER=mock

# Claude (AI_PROVIDER=claude). Model is optional (defaults to claude-sonnet-4).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI (AI_PROVIDER=openai). Model is optional (defaults to gpt-4o).
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenLLM — any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio).
# Base URL + model are required when AI_PROVIDER=openllm; key is optional.
OPENLLM_BASE_URL=
OPENLLM_MODEL=
OPENLLM_API_KEY=

# Client routing flag (NOT a credential): mock | live. `live` proxies the
# browser through /api/v1/ai/chat to the server-side provider above. Default: mock.
NEXT_PUBLIC_AI_MODE=mock

# --- Wave3b API gateway (server-side only) ---
# Bearer token for the /api/v1/ai/chat gateway (one key per tenant). When unset
# AND AI_PROVIDER=mock (the default), auth is NOT enforced so the offline demo
# and CI stay green with zero config. Enforcement turns on when this is set OR a
# live provider (claude|openai|openllm) is selected; requests then need
# `Authorization: Bearer <token>`. Standard tier: 1,000 req/min per tenant.
RATIO_API_TOKEN=

# --- Wave4 Slice 3: ChangeManagementClient seam (server-side only) ---
# Provider router. One of: mock | jira | servicenow. Default: mock (offline-safe,
# no creds required). Switch to jira/servicenow to activate live adapters.
CM_PROVIDER=mock

# Jira (CM_PROVIDER=jira). All three are required.
# JIRA_BASE_URL=https://yourorg.atlassian.net
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=OPS

# ServiceNow (CM_PROVIDER=servicenow). All three are required.
# SERVICENOW_INSTANCE=yourinstance.service-now.com
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# Client routing flag. mock | live. `live` proxies through /api/v1/cm/change.
# Default: mock. Switch to `live` when CM_PROVIDER is set to a real backend.
NEXT_PUBLIC_CM_MODE=mock

# --- FinIO A2A interchange (server-side only) ---
# Shared secret a peer agent presents (header: X-FinIO-Peer-Token) to open a
# FinIO session. When UNSET, the handshake does not enforce a peer token, so the
# offline demo and CI stay green with zero config — the same offline-safe
# invariant the API gateway uses. Set it and enforcement turns on immediately.
FINIO_PEER_TOKEN=

# Key used to sign FinIO session tokens. When unset, a random key is generated
# per process, so sessions do not survive a restart — fine for local dev.
#
# REQUIRED on serverless or any multi-instance host (Vercel, Lambda, more than
# one container). There the handshake and the export can land on different
# instances, each with its own random key, and the export rejects a session the
# handshake just minted — an intermittent 401 that looks like a broken exchange.
# Any long random string works: `openssl rand -hex 32`.
FINIO_SESSION_SECRET=

# Client-side copy of the peer token, for a browser demo against a deployment
# that enforces one. NOT a server secret: anything NEXT_PUBLIC_ is compiled into
# the bundle and readable by any visitor. Leave unset unless you specifically
# want the /finio page to authenticate itself.
NEXT_PUBLIC_FINIO_PEER_TOKEN=

# --- Phase 1 legacy (AgentClient) ---
# Legacy: NEXT_PUBLIC_ANTHROPIC_API_KEY — the Phase 1 client-side agent key.
# Superseded by the server-proxied AIClient seam above; safe to leave unset.
NEXT_PUBLIC_ANTHROPIC_API_KEY=

