# Ratio environment configuration. EVERY variable below is optional: with none
# set, the app runs fully offline on the data-grounded mock (MockAIClient).

# Browser-visible Webflow Cloud mount path. Leave empty for local/root hosting.
# Set to /ratio in the Webflow Cloud environment mounted at adaptcloud.io/ratio.
NEXT_PUBLIC_BASE_PATH=

# --- Wave3b AIClient seam (server-side only — keys NEVER reach the browser) ---
# Provider router. One of: claude | openai | mistral | qwen | openllm | mock.
# Aliases for self-hosted open-weight servers: ollama | vllm | tgi | lmstudio |
# llama.cpp | open-weight (all → openllm). Default: mock.
AI_PROVIDER=mock

# Claude (AI_PROVIDER=claude). Model is optional (defaults to claude-sonnet-4).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI (AI_PROVIDER=openai). Model is optional (defaults to gpt-4o).
OPENAI_API_KEY=
OPENAI_MODEL=

# Mistral (AI_PROVIDER=mistral). Model defaults to mistral-large-latest; base URL
# defaults to https://api.mistral.ai/v1.
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_BASE_URL=

# Qwen via Alibaba Cloud Model Studio / DashScope (AI_PROVIDER=qwen).
# QWEN_API_KEY or DASHSCOPE_API_KEY. Model defaults to qwen-plus; base URL
# defaults to the international compatible-mode endpoint
# (https://dashscope-intl.aliyuncs.com/compatible-mode/v1).
QWEN_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=

# OpenLLM — any OpenAI-compatible endpoint: self-hosted open-weight models on
# vLLM, Ollama, TGI, LM Studio, llama.cpp (Llama, Mixtral, Qwen, DeepSeek,
# Gemma...) or any other hosted compatible API.
# Base URL + model are required when AI_PROVIDER=openllm; key is optional.
OPENLLM_BASE_URL=
OPENLLM_MODEL=
OPENLLM_API_KEY=

# Client routing flag (NOT a credential): mock | live. `live` proxies the
# browser through /api/v1/ai/chat to the server-side provider above. Default: mock.
NEXT_PUBLIC_AI_MODE=mock

# --- Wave3b API gateway (server-side only) ---
# Bearer token for the /api/v1/ai/chat gateway (one key per tenant). When unset
# AND AI_PROVIDER=mock (the default), auth is NOT enforced so the offline demo
# and CI stay green with zero config. Enforcement turns on when this is set OR a
# live AI provider (anything but mock) is selected; requests then need
# `Authorization: Bearer <token>`. Standard tier: 1,000 req/min per tenant.
# Also REQUIRED to read rows from a live cost connector (below), and must then be
# at least 32 characters with at least 10 distinct characters — a weaker token
# refuses live cost data (503).
RATIO_API_TOKEN=

# --- Wave4 Slice 3: ChangeManagementClient seam (server-side only) ---
# Provider router. One of: mock | jira | servicenow. Default: mock (offline-safe,
# no creds required). Switch to jira/servicenow to activate live adapters.
CM_PROVIDER=mock

# Jira (CM_PROVIDER=jira). All three are required.
# JIRA_BASE_URL=https://yourorg.atlassian.net
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=OPS

# ServiceNow (CM_PROVIDER=servicenow). All three are required.
# SERVICENOW_INSTANCE=yourinstance.service-now.com
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=

# Client routing flag. mock | live. `live` proxies through /api/v1/cm/change.
# Default: mock. Switch to `live` when CM_PROVIDER is set to a real backend.
NEXT_PUBLIC_CM_MODE=mock

# --- FinIO A2A interchange (server-side only) ---
# Shared secret a peer agent presents (header: X-FinIO-Peer-Token) to open a
# FinIO session. When UNSET, the handshake does not enforce a peer token, so the
# offline demo and CI stay green with zero config — the same offline-safe
# invariant the API gateway uses. Set it and enforcement turns on immediately.
FINIO_PEER_TOKEN=

# Key used to sign FinIO session tokens. When unset, a random key is generated
# per process, so sessions do not survive a restart — correct for a single-
# instance demo. Pin it only when running more than one instance behind a load
# balancer, so a session minted by one instance validates on another.
FINIO_SESSION_SECRET=

# There is deliberately NO browser (NEXT_PUBLIC_) copy of the peer token: it
# would be compiled into the client bundle. With FINIO_PEER_TOKEN set, the
# /finio/demo page's live mode reports "peer authentication required"; peer
# agents call the API directly with X-FinIO-Peer-Token.

# --- Cost connectors (server-side only) ---
# Each connector goes live as soon as its required env is set — no flag needed.
# COSTSOURCE_<NAME>_LIVE=false is a kill-switch that keeps a connector off.
# Reading live rows requires RATIO_API_TOKEN (Bearer). See README "Cost connectors".
# Failed-auth rate limiting keys on the socket address. Set this ONLY when the
# app runs behind N trusted proxies that append to X-Forwarded-For; the Nth
# entry from the right is then used as the client IP. Unset = XFF ignored.
# RATIO_TRUSTED_PROXY_HOPS=

# Azure Cost Management FOCUS export: container URL [+ path] (single-blob URLs are rejected).
# AZURE_FOCUS_EXPORT_URL=https://<account>.blob.core.windows.net/<container>/<path>
# AZURE_FOCUS_SAS=sv=...&sig=...          # needs read + list
# COSTSOURCE_AZURE_LIVE=

# AWS Data Exports (FOCUS 1.0) in S3 — or any S3-compatible store via AWS_S3_ENDPOINT.
# AWS_FOCUS_EXPORT_BUCKET=<bucket>[/<prefix>]
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                      # temporary credentials
# AWS_FOCUS_EXPORT_PREFIX=
# AWS_S3_ENDPOINT=https://minio.internal:9000   # on-prem / private cloud
# COSTSOURCE_AWS_LIVE=

# GCP FOCUS view in BigQuery. Credentials: file path, inline JSON, or base64 JSON.
# GCP_FOCUS_BQ_DATASET=<dataset>.<table>  # or <project>.<dataset>.<table>
# GCP_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
# COSTSOURCE_GCP_LIVE=

# Kubernetes — OpenCost / Kubecost FOCUS export endpoint ({start}/{end} allowed).
# KUBERNETES_FOCUS_ENDPOINT=http://opencost.opencost.svc:9003/focus
# KUBERNETES_FOCUS_TOKEN=
# COSTSOURCE_KUBERNETES_LIVE=

# Nutanix Cloud Manager cost governance FOCUS export (X-ntnx-api-key header).
# NUTANIX_ENDPOINT=
# NUTANIX_API_KEY=
# COSTSOURCE_NUTANIX_LIVE=

# --- Phase 1 legacy (AgentClient) ---
# Legacy: NEXT_PUBLIC_ANTHROPIC_API_KEY — the Phase 1 client-side agent key.
# Superseded by the server-proxied AIClient seam above; safe to leave unset.
NEXT_PUBLIC_ANTHROPIC_API_KEY=

