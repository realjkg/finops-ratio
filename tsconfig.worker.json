{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "src",
    "outDir": "dist-worker",
    "sourceMap": true,
    "declaration": false,
    "noEmit": false,
    "incremental": false
  },
  "include": ["src/ingest/**/*.ts", "src/engagement/auth/usersCli.ts", "src/platform/contracts/*.ts"],
  "exclude": ["src/ingest/**/*.test.ts", "src/ingest/**/testing/**", "src/platform/**/*.test.ts"]
}
